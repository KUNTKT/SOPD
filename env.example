# Copy to .env and export, or set in the shell before running scripts.

# Hugging Face / local Qwen checkpoint
export SSOPD_MODEL=/path/to/Qwen3-1.7B
# export SSOPD_MODEL_8B=/path/to/Qwen3-8B

# ALFWorld data root (json_2.1.1)
export ALFWORLD_DATA=/path/to/alfworld

# Optional: point at a full SSOPD checkout instead of ./third_party
# export SSOPD_ROOT=/path/to/SSOPD

export PYTHONPATH="$(pwd)/scripts:$(pwd)/third_party:$(pwd)/third_party/ssopd_logits:${PYTHONPATH}"
export PYTHONUNBUFFERED=1
